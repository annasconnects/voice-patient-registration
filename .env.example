# ---- Backend (set these on Railway/Render) ----
# Postgres connection string. Railway: reference ${{Postgres.DATABASE_URL}}.
# Leave unset locally to use SQLite at ./data/patients.db
DATABASE_URL=
# Shared secret; Vapi sends it in the x-vapi-secret header. Use a long random string.
VAPI_SECRET=
# Optional: require X-API-Key on POST/PUT/DELETE /patients. Leave empty for open review access.
API_KEY=
# Insert 2 fictional demo patients when the table is empty
SEED_DATA=true
LOG_LEVEL=INFO
# Timezone used to present mock appointment slots
CLINIC_TIMEZONE=America/New_York

# ---- Only needed on your machine to run scripts/setup_vapi.py ----
VAPI_API_KEY=
PUBLIC_BASE_URL=https://your-app.up.railway.app
# Optional: which Vapi phone number to attach the assistant to
VAPI_PHONE_NUMBER_ID=
# Optional overrides
LLM_MODEL=gpt-4o
VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---- Only for scripts/simulate_call.py (text-mode test without a phone) ----
OPENAI_API_KEY=
